# ==============================================================================
# Lodana Agro — Variables de entorno
# ==============================================================================
#
# OPCIÓN A: Base de datos local estática para pruebas (PostgreSQL 16 local)
# Inicia el servidor local con: pnpm run db:test:start
# Carga datos de prueba con:    pnpm run db:seed
DATABASE_URL="postgresql://lodana@127.0.0.1:5433/lodana_test?schema=public"
DIRECT_URL="postgresql://lodana@127.0.0.1:5433/lodana_test?schema=public"
#
# OPCIÓN B: Neon (PostgreSQL Serverless en producción / staging)
# En Neon Console -> Connection Details:
#   - DATABASE_URL = cadena POOLED (contiene "-pooler." y ?sslmode=require)
#   - DIRECT_URL   = cadena DIRECT (sin "-pooler.", usada por prisma migrate)
# DATABASE_URL="postgresql://<user>:<password>@ep-<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&connect_timeout=15"
# DIRECT_URL="postgresql://<user>:<password>@ep-<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# Secreto HMAC para firmar sesiones (obligatorio en producción, mínimo 32 caracteres aleatorios)
LODANA_SESSION_SECRET="reemplaza-por-un-secreto-aleatorio-de-al-menos-32-caracteres-hex"

# Origen canónico de la aplicación para validación CSRF estricta (ej. https://lodana.ejemplo.com)
APP_ORIGIN="http://localhost:3000"

# Claves / PINs de acceso por perfil (4 a 64 caracteres; en producción usa claves fuertes)
LODANA_PIN_PRODUCTION="1234"
LODANA_PIN_RECEPTION="2345"
LODANA_PIN_QUERIES="3456"
LODANA_PIN_ADMIN="9999"

# Secreto Bearer para ejecutar el endpoint de cron de reportes automáticos (/api/cron/reports)
# En producción reemplaza por un token aleatorio de al menos 32 caracteres.
LODANA_CRON_SECRET="reemplaza-por-un-secreto-aleatorio-para-cron-de-al-menos-32-caracteres"
