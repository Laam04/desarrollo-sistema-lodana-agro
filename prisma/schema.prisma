generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Crop {
  id              String           @id @default(cuid())
  name            String
  normalizedName  String           @unique
  hasVarieties    Boolean          @default(false)
  hasLots         Boolean          @default(false)
  tracksSurface   Boolean          @default(false)
  hasOtherDetails Boolean          @default(false)
  active          Boolean          @default(true)
  unitId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  unit            Unit?            @relation(fields: [unitId], references: [id])
  varieties       Variety[]
  lots            Lot[]
  zones           Zone[]
  harvests        Harvest[]
  losses          Loss[]
  shipments       Shipment[]
  costAllocations CostAllocation[]

  @@index([active, createdAt])
}

model Variety {
  id             String     @id @default(cuid())
  cropId         String
  name           String
  normalizedName String
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  crop           Crop       @relation(fields: [cropId], references: [id])
  harvests       Harvest[]
  losses         Loss[]
  shipments      Shipment[]

  @@unique([cropId, normalizedName])
  @@index([cropId, active])
}

model Lot {
  id             String     @id @default(cuid())
  cropId         String
  name           String
  normalizedName String
  surface        Decimal?   @db.Decimal(12, 2)
  surfaceUnit    String?    @default("ha")
  notes          String?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  crop           Crop       @relation(fields: [cropId], references: [id])
  harvests       Harvest[]
  losses         Loss[]
  shipments      Shipment[]

  @@unique([cropId, normalizedName])
  @@index([cropId, active])
}

model Zone {
  id             String   @id @default(cuid())
  cropId         String
  name           String
  normalizedName String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  crop           Crop     @relation(fields: [cropId], references: [id])

  @@unique([cropId, normalizedName])
  @@index([cropId, active])
}

model Unit {
  id        String     @id @default(cuid())
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  crops     Crop[]
  harvests  Harvest[]
  losses    Loss[]
  shipments Shipment[]

  @@index([active])
}

model Harvest {
  id        String   @id @default(cuid())
  date      DateTime
  cropId    String
  varietyId String?
  lotId     String?
  quantity  Decimal  @db.Decimal(12, 2)
  unitId    String
  notes     String?
  status    String   @default("ACTIVE")
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  crop      Crop     @relation(fields: [cropId], references: [id])
  variety   Variety? @relation(fields: [varietyId], references: [id])
  lot       Lot?     @relation(fields: [lotId], references: [id])
  unit      Unit     @relation(fields: [unitId], references: [id])

  @@index([date, cropId])
  @@index([status])
}

model LossReason {
  id             String   @id @default(cuid())
  name           String   @unique
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  losses         Loss[]
}

model Loss {
  id        String     @id @default(cuid())
  date      DateTime
  cropId    String
  varietyId String?
  lotId     String?
  quantity  Decimal    @db.Decimal(12, 2)
  unitId    String
  reasonId  String
  notes     String?
  status    String     @default("ACTIVE")
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  crop      Crop       @relation(fields: [cropId], references: [id])
  variety   Variety?   @relation(fields: [varietyId], references: [id])
  lot       Lot?       @relation(fields: [lotId], references: [id])
  unit      Unit       @relation(fields: [unitId], references: [id])
  reason    LossReason @relation(fields: [reasonId], references: [id])

  @@index([date, cropId])
}

model CostCategory {
  id             String            @id @default(cuid())
  name           String            @unique
  normalizedName String            @unique
  active         Boolean           @default(true)
  subcategories  CostSubcategory[]
  costs          Cost[]
}

model CostSubcategory {
  id             String       @id @default(cuid())
  categoryId     String
  name           String
  normalizedName String
  active         Boolean      @default(true)
  category       CostCategory @relation(fields: [categoryId], references: [id])
  costs          Cost[]

  @@unique([categoryId, normalizedName])
}

model Cost {
  id              String           @id @default(cuid())
  date            DateTime
  description     String
  categoryId      String
  subcategoryId   String?
  amountUsd       Decimal          @db.Decimal(12, 2)
  notes           String?
  applicationType String           @default("GENERAL")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        CostCategory     @relation(fields: [categoryId], references: [id])
  subcategory     CostSubcategory? @relation(fields: [subcategoryId], references: [id])
  allocations     CostAllocation[]

  @@index([date, categoryId])
}

model CostAllocation {
  id        String   @id @default(cuid())
  costId    String
  cropId    String?
  amountUsd Decimal? @db.Decimal(12, 2)
  percent   Decimal? @db.Decimal(7, 4)
  cost      Cost     @relation(fields: [costId], references: [id])
  crop      Crop?    @relation(fields: [cropId], references: [id])

  @@index([costId])
}

model Shipment {
  id             String   @id @default(cuid())
  date           DateTime
  cropId         String
  varietyId      String?
  lotId          String?
  quantity       Decimal  @db.Decimal(12, 2)
  marketQuantity Decimal? @db.Decimal(12, 2)
  unitId         String
  unitPrice      Decimal  @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(14, 2)
  notes          String?
  status         String   @default("ACTIVE")
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  crop           Crop     @relation(fields: [cropId], references: [id])
  variety        Variety? @relation(fields: [varietyId], references: [id])
  lot            Lot?     @relation(fields: [lotId], references: [id])
  unit           Unit     @relation(fields: [unitId], references: [id])

  @@index([date, cropId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  action     String
  actor      String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
}
