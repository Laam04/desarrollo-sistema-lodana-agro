generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductionAreaType {
  LOT
  ZONE
}

model Crop {
  id                 String    @id @default(cuid())
  name               String
  normalizedName     String    @unique
  hasVarieties       Boolean   @default(false)
  hasProductionAreas Boolean   @default(false)
  tracksSurface      Boolean   @default(false)
  hasOtherDetails    Boolean   @default(false)
  active             Boolean   @default(true)
  unitId             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  unit                 Unit?                  @relation(fields: [unitId], references: [id])
  varieties            Variety[]
  productionAreas      ProductionArea[]
  harvests             Harvest[]
  shipmentItems        ShipmentItem[]
  costAllocations      CostAllocation[]
  marketReferencePrices MarketReferencePrice[]

  @@index([active, createdAt])
  @@index([unitId])
}

model Variety {
  id             String    @id @default(cuid())
  cropId         String
  name           String
  normalizedName String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  crop          Crop           @relation(fields: [cropId], references: [id])
  harvests      Harvest[]
  shipmentItems ShipmentItem[]

  @@unique([cropId, normalizedName])
  @@index([cropId, active])
}

model ProductionArea {
  id             String             @id @default(cuid())
  cropId         String
  zoneId         String?
  name           String
  normalizedName String
  type           ProductionAreaType
  surface        Decimal?           @db.Decimal(12, 2)
  surfaceUnit    String?
  notes          String?
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  crop          Crop           @relation(fields: [cropId], references: [id])
  zone          Zone?          @relation(fields: [zoneId], references: [id])
  harvests      Harvest[]
  shipmentItems ShipmentItem[]

  @@unique([cropId, normalizedName])
  @@index([cropId, active])
  @@index([zoneId])
}

model Zone {
  id             String           @id @default(cuid())
  name           String
  normalizedName String           @unique
  productionAreas ProductionArea[]
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  crops                 Crop[]
  harvests              Harvest[]
  shipmentItems         ShipmentItem[]
  saleReceptionItems    ReceptionItem[]        @relation("ReceptionItemSaleUnit")
  marketReferencePrices MarketReferencePrice[]

  @@index([active])
}

model Harvest {
  id                 String    @id @default(cuid())
  date               DateTime
  cropId             String
  varietyId          String?
  productionAreaId   String?
  quantity           Decimal   @db.Decimal(12, 2)
  unitId             String
  estimatedUnitPrice Decimal?  @db.Decimal(12, 2)
  notes              String?
  status             String    @default("ACTIVE")
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  crop           Crop                 @relation(fields: [cropId], references: [id])
  variety        Variety?             @relation(fields: [varietyId], references: [id])
  productionArea ProductionArea?      @relation(fields: [productionAreaId], references: [id])
  unit           Unit                 @relation(fields: [unitId], references: [id])
  losses         Loss[]
  allocations    ShipmentAllocation[]

  @@index([date, cropId])
  @@index([cropId, date])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
}

model LossReason {
  id             String    @id @default(cuid())
  name           String    @unique
  normalizedName String    @unique
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  losses Loss[]
}

model Loss {
  id                String    @id @default(cuid())
  harvestId         String
  date              DateTime
  quantity          Decimal   @db.Decimal(12, 2)
  affectsHarvest    Boolean?
  reasonId          String
  notes             String?
  evidenceImage     String?
  evidenceImageName String?
  status            String    @default("ACTIVE")
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  harvest Harvest    @relation(fields: [harvestId], references: [id])
  reason  LossReason @relation(fields: [reasonId], references: [id])

  @@index([harvestId, date])
  @@index([harvestId, affectsHarvest])
  @@index([date])
  @@index([reasonId])
  @@index([status])
}

model CostCategory {
  id             String            @id @default(cuid())
  name           String            @unique
  normalizedName String            @unique
  active         Boolean           @default(true)
  subcategories  CostSubcategory[]
  costs          Cost[]
  deletedAt      DateTime?
}

model CostSubcategory {
  id             String    @id @default(cuid())
  categoryId     String
  name           String
  normalizedName String
  active         Boolean   @default(true)
  deletedAt      DateTime?

  category CostCategory @relation(fields: [categoryId], references: [id])
  costs    Cost[]

  @@unique([categoryId, normalizedName])
}

model Cost {
  id               String    @id @default(cuid())
  date             DateTime
  description      String
  categoryId       String
  subcategoryId    String?
  amountUsd        Decimal   @db.Decimal(12, 2)
  notes            String?
  receiptImage     String?
  receiptImageName String?
  applicationType  String    @default("GENERAL")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  category    CostCategory     @relation(fields: [categoryId], references: [id])
  subcategory CostSubcategory? @relation(fields: [subcategoryId], references: [id])
  allocations CostAllocation[]

  @@index([date, categoryId])
  @@index([categoryId])
  @@index([subcategoryId])
}

model CostAllocation {
  id        String    @id @default(cuid())
  costId    String
  cropId    String?
  amountUsd Decimal?  @db.Decimal(12, 2)
  percent   Decimal?  @db.Decimal(7, 4)
  deletedAt DateTime?

  cost Cost  @relation(fields: [costId], references: [id])
  crop Crop? @relation(fields: [cropId], references: [id])

  @@index([costId])
  @@index([cropId])
}

model Shipment {
  id            String    @id @default(cuid())
  requestId     String?   @unique
  code          String    @unique
  date          DateTime
  status        String    @default("IN_TRANSIT")
  notes         String?
  noteImage     String?
  noteImageName String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  items      ShipmentItem[]
  receptions Reception[]

  @@index([date])
  @@index([status])
}

model ShipmentItem {
  id                   String    @id @default(cuid())
  shipmentId           String
  cropId               String
  varietyId            String?
  productionAreaId     String?
  quantity             Decimal   @db.Decimal(12, 2)
  unitId               String
  estimatedUnitPrice   Decimal?  @db.Decimal(12, 2)
  estimatedTotalAmount Decimal?  @db.Decimal(14, 2)
  notes                String?
  deletedAt            DateTime?

  shipment       Shipment             @relation(fields: [shipmentId], references: [id])
  crop           Crop                 @relation(fields: [cropId], references: [id])
  variety        Variety?             @relation(fields: [varietyId], references: [id])
  productionArea ProductionArea?      @relation(fields: [productionAreaId], references: [id])
  unit           Unit                 @relation(fields: [unitId], references: [id])
  allocations    ShipmentAllocation[]
  receptionItems ReceptionItem[]

  @@index([shipmentId])
  @@index([cropId])
  @@index([unitId])
}

model ShipmentAllocation {
  id             String    @id @default(cuid())
  shipmentItemId String
  harvestId      String
  quantity       Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  shipmentItem ShipmentItem @relation(fields: [shipmentItemId], references: [id])
  harvest      Harvest      @relation(fields: [harvestId], references: [id])

  @@unique([shipmentItemId, harvestId])
  @@index([harvestId])
}

model Reception {
  id         String    @id @default(cuid())
  receiptNumber Int    @unique @default(autoincrement())
  shipmentId String
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)
  receivedBy String?
  closesWithDifferences Boolean @default(false)
  notes      String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  shipment Shipment        @relation(fields: [shipmentId], references: [id])
  items    ReceptionItem[]

  @@index([shipmentId, receivedAt])
  @@index([receivedAt])
}

model ReceptionItem {
  id                String    @id @default(cuid())
  receptionId       String
  shipmentItemId    String
  receivedQuantity  Decimal   @db.Decimal(12, 2)
  customerUnitPrice Decimal?  @db.Decimal(12, 2)
  notes             String?
  saleUnitId        String?
  saleQuantity      Decimal?  @db.Decimal(12, 2)
  saleUnitCost      Decimal?  @db.Decimal(12, 4)
  parentItemId      String?
  convertedFromQty  Decimal?  @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  reception    Reception       @relation(fields: [receptionId], references: [id])
  shipmentItem ShipmentItem    @relation(fields: [shipmentItemId], references: [id])
  saleUnit     Unit?           @relation("ReceptionItemSaleUnit", fields: [saleUnitId], references: [id])
  parentItem   ReceptionItem?  @relation("ReceptionItemConversions", fields: [parentItemId], references: [id])
  conversions  ReceptionItem[] @relation("ReceptionItemConversions")
  sales        MarketSale[]

  @@index([receptionId, shipmentItemId])
  @@index([shipmentItemId])
  @@index([parentItemId])
  @@index([saleUnitId])
}

model MarketReferencePrice {
  id            String   @id @default(cuid())
  cropId        String
  unitId        String
  marketName    String   @default("Mercado local (Manabí)")
  source        String   @default("Referencia local")
  priceUsd      Decimal  @db.Decimal(12, 2)
  minPriceUsd   Decimal? @db.Decimal(12, 2)
  maxPriceUsd   Decimal? @db.Decimal(12, 2)
  effectiveDate DateTime
  notes         String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  crop Crop @relation(fields: [cropId], references: [id])
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([cropId, unitId])
  @@index([cropId])
  @@index([unitId])
  @@index([effectiveDate])
}

enum MarketPayment {
  CASH
  TRANSFER
}

model MarketSale {
  id               String        @id @default(cuid())
  receptionItemId  String
  date             DateTime
  quantity         Decimal       @db.Decimal(12, 2)
  unitPrice        Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(14, 2)
  payment          MarketPayment?
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  cancelledAt      DateTime?

  receptionItem ReceptionItem @relation(fields: [receptionItemId], references: [id])

  @@index([date, cancelledAt])
  @@index([receptionItemId, cancelledAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  action     String
  actor      String?
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@index([createdAt])
  @@index([actor, createdAt])
}

model TrashEntry {
  id           String    @id @default(cuid())
  entityType   String
  entityId     String
  groupId      String    @default(cuid())
  deletedAt    DateTime  @default(now())
  purgeAt      DateTime
  deletedBy    String?
  restoredAt   DateTime?
  restoredBy   String?
  snapshotJson Json?

  @@index([groupId])
  @@index([entityType, entityId])
  @@index([purgeAt, restoredAt])
  @@index([deletedAt])
}

model ProfileLoginAttempt {
  profile     String
  clientKey   String   @default("global")
  attempts    Int
  windowStart DateTime @db.Timestamptz(3)

  @@id([profile, clientKey])
  @@index([windowStart])
}

model ProfileSession {
  jti       String    @id
  profile   String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([profile, revokedAt])
  @@index([expiresAt])
}

model ProfileAccessConfig {
  profile   String   @id
  enabled   Boolean  @default(true)
  pinHash   String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  updatedBy String?
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  updatedBy String?
}

model GeneratedReport {
  id           String   @id @default(cuid())
  dedupeKey    String?  @unique
  type         String
  title        String
  trigger      String
  cadence      String
  status       String   @default("READY")
  periodFrom   String
  periodTo     String
  periodLabel  String
  filtersJson  Json?
  summaryJson  Json?
  payloadJson  Json?
  errorMessage String?
  attempts     Int      @default(1)
  generatedBy  String
  generatedAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@index([type, generatedAt])
  @@index([trigger, cadence, periodFrom, periodTo])
  @@index([status, generatedAt])
  @@index([generatedAt])
}

model ReportAutomationRun {
  id             String    @id @default(cuid())
  source         String
  status         String
  checkedPeriods Int       @default(0)
  createdCount   Int       @default(0)
  skippedCount   Int       @default(0)
  failedCount    Int       @default(0)
  detailsJson    Json?
  startedAt      DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)

  @@index([startedAt])
}
